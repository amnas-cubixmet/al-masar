# Contact form email delivery via Gmail / Google Workspace App Password
# Never commit the real App Password.

SMTP_USER=your-email@gmail.com
SMTP_APP_PASSWORD=your-16-character-app-password

# Optional: where website enquiries should be delivered.
# If omitted, SMTP_USER receives the emails.
CONTACT_TO_EMAIL=

# Gmail defaults. Change only if you use another SMTP provider.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
